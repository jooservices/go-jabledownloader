# Observability (optional). When OBS_ENDPOINT is empty the CLI runs without
# telemetry. When set, events are pushed to the JOOservices OpenObserve
# (repo: jooservices/openobserve) as basic-auth OTLP.
OBS_ENDPOINT=http://localhost:5080
OBS_ORG=jooservices
OBS_STREAM=jabledownloader
OBS_USER=telemetry@jooservices.com
OBS_PASSWORD=change-me
